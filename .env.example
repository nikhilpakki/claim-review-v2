# AWS region Textract calls are made in
AWS_REGION=ap-south-1

# Optional: pre-fill the folder browser with a starting path
DEFAULT_ROOT_DIR=

# Where runtime data (SQLite DB, Textract/page cache) is written
DATABASE_PATH=var/reviews.db
CACHE_DIR=var/cache

# Used to sign the Flask session cookie (holds the active root folder)
FLASK_SECRET_KEY=change-me

# Optional: default reviewer name shown in the review form
REVIEWER_NAME=


# ----------------------------------------------------------------- fetching
# Where fetched claim bundles land. Each subfolder is a registration ID, so
# this path doubles as a review root folder. It holds every downloaded PDF and
# image, so prefer a local disk that is NOT cloud-synced (OneDrive/Dropbox).
BUNDLES_ROOT=var/claim-bundles

# Where the per-run JSON/XLSX pipeline reports are written
PIPELINE_REPORT_DIR=var/pipeline_reports

# Warehouse holding the claim index. The DB_* names used by the
# claim-bundle-extraction pipeline's .env are accepted as fallbacks, so an
# existing pipeline .env can be reused as-is.
REDSHIFT_HOST=xyz.compute-1.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DB=sample_db
REDSHIFT_USER=username
REDSHIFT_PASSWORD=password
REDSHIFT_SSLMODE=require
REDSHIFT_CONNECT_TIMEOUT=15

# Source of claims to fetch, destination schema for the extracted tables, and
# the client S3 bucket the bundles are downloaded from
CLAIM_SOURCE_TABLE=dmart_solution.claim_paid_t
CLAIM_TARGET_SCHEMA=public
S3_SOURCE_BUCKET=mumpmjprodpmjayapp

# Concurrency: claims in parallel, and S3 objects in parallel within a claim
FETCH_CLAIM_WORKERS=8
FETCH_DOWNLOAD_WORKERS=4
FETCH_INSERT_BATCH_ROWS=500

# Default "latest N claims" value on the Fetch page, and whether
# "Load extracted tables into Redshift" starts ticked (1/0)
FETCH_DEFAULT_LIMIT=100
FETCH_LOAD_REDSHIFT_DEFAULT=1
