# systemd unit for the claim review tool.
#   sudo pip3 install -r /opt/claim-review/requirements.txt
#   sudo cp deploy/claim-review.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now claim-review
#
# No virtualenv: the packages are installed against the system python3, and
# ExecStart runs gunicorn through it. `python3 -m gunicorn` rather than the
# `gunicorn` script on purpose - the script's location depends on how pip was
# invoked (/usr/local/bin for a root install, ~/.local/bin for a --user one),
# and systemd needs an absolute path that exists either way. Check it before
# installing the unit:
#
#   /usr/bin/python3 -m gunicorn --version
#
# If that python3 is not the one the packages went to, point ExecStart at the
# one that is - `which python3` under the ec2-user account.
#
# Replaces running the dev server inside tmux: survives logout and reboot,
# restarts on crash, and writes to the journal instead of a scrollback buffer.
[Unit]
Description=Claim Review tool
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/claim-review
EnvironmentFile=/opt/claim-review/.env

# One worker, many threads - see wsgi.py for why the worker count must stay 1.
# A request never does the long work: fetching, processing and the folder scan
# all run on background threads, so 120s is generous for anything a reviewer
# waits on. It is not 0 (no limit) on purpose - a worker wedged on a stuck
# network read would otherwise never be replaced - but it must stay well above
# the slowest honest request, because a worker killed mid-flight loses the
# in-memory progress every /fetch and /process page is polling for.
#
# --bind 127.0.0.1:5000 means nginx is the only way in, which is what
# deploy/nginx-claim-review.conf is for: reviewers use port 80 and the app
# is not exposed directly. If nginx is not installed, nothing outside the
# box can reach this and the tool will look dead - either install nginx, or
# change the bind below to 0.0.0.0:5000 and open 5000 in the security group.
# Binding 0.0.0.0 without nginx also means no TLS and no upload limit.
ExecStart=/usr/bin/python3 -m gunicorn \
    --workers 1 \
    --threads 16 \
    --worker-class gthread \
    --bind 127.0.0.1:5000 \
    --timeout 120 \
    --graceful-timeout 30 \
    --access-logfile - \
    --error-logfile - \
    wsgi:app

Restart=always
RestartSec=5
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
