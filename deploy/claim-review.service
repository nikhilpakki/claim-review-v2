# systemd unit for the claim review tool.
#   sudo cp deploy/claim-review.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now claim-review
#
# Replaces running the dev server inside tmux: survives logout and reboot,
# restarts on crash, and writes to the journal instead of a scrollback buffer.
[Unit]
Description=Claim Review tool
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/claim-review
EnvironmentFile=/opt/claim-review/.env

# One worker, many threads - see wsgi.py for why the worker count must stay 1.
# A request never does the long work: fetching, processing and the folder scan
# all run on background threads, so 120s is generous for anything a reviewer
# waits on. It is not 0 (no limit) on purpose - a worker wedged on a stuck
# network read would otherwise never be replaced - but it must stay well above
# the slowest honest request, because a worker killed mid-flight loses the
# in-memory progress every /fetch and /process page is polling for.
ExecStart=/opt/claim-review/.venv/bin/gunicorn \
    --workers 1 \
    --threads 16 \
    --worker-class gthread \
    --bind 127.0.0.1:5000 \
    --timeout 120 \
    --graceful-timeout 30 \
    --access-logfile - \
    --error-logfile - \
    wsgi:app

Restart=always
RestartSec=5
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
